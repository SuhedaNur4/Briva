# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# Gizli anahtar — üretimde uzun ve rastgele bir değer kullanın
SECRET_KEY=briva-secret-key-change-in-production

# JWT
JWT_SECRET_KEY=briva-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Veritabanı
# SQLite (geliştirme)
DATABASE_URL=sqlite:///briva.db

# PostgreSQL'e geçmek için bu satırı aktifleştirin:
# DATABASE_URL=postgresql://user:password@localhost:5432/briva_db

# Google Gemini AI — AI Analyzer ve Semantic Recommendation için gerekli
# Ücretsiz key almak için: https://aistudio.google.com/app/apikey
# Key yoksa sistem kural tabanlı fallback ile çalışmaya devam eder.
GEMINI_API_KEY=your_gemini_api_key_here
